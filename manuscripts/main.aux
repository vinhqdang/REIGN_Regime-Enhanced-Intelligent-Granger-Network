\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Training dynamics of the Augmented Lagrangian GNN. (a) Prediction loss $\mathcal  {L}_{MSE}$ converges faster and lower for REIGN (Full) than for REIGN w/ LASSO Bottleneck, confirming that dense initialisation enables better gradient flow. (b) DAG acyclicity constraint $h(\mathbf  {W})$ convergence: the full model reaches the tolerance $\epsilon _{tol}$ (grey dotted line) in fewer outer iterations.}}{10}{figure.8}\protected@file@percent }
\newlabel{fig:convergence}{{8}{10}{Training dynamics of the Augmented Lagrangian GNN. (a) Prediction loss $\mathcal {L}_{MSE}$ converges faster and lower for REIGN (Full) than for REIGN w/ LASSO Bottleneck, confirming that dense initialisation enables better gradient flow. (b) DAG acyclicity constraint $h(\mathbf {W})$ convergence: the full model reaches the tolerance $\epsilon _{tol}$ (grey dotted line) in fewer outer iterations}{figure.8}{}}
