  "hypothesis": "For a panel with N columns and conditioner c: assets = columns minus c (N' = N-1); hypotheses = { (C, {A,B}) : C in assets, {A,B} an unordered pair of distinct assets in assets minus {C} }, so the count is N' * C(N'-1, 2).",
  "test": {
    "estimator": "v2 (ante_v2)",
    "kinds": [
      "addjoint",
      "four"
    ],
    "forget": 0.995,
    "ridge": 0.01,
    "feat_clip": 5.0,
    "std_warmup": 30,
    "cap": 3.0,
    "gamma": 0.9,
    "warmup": 50,
    "alpha": 0.05,
    "reject_threshold": 20.0,
    "tail_q": 0.9,
    "tail_min": 100,
    "exclusion_deltas": [
      0.0005,
      0.001,
      0.002,
      0.005,
      0.01,
      0.02,
      0.05
    ],
    "exclusion_threshold_per_hypothesis": 20.0,
    "fdr_levels": [
      0.1,
      0.05
    ],
    "seed_subsample": 0,
    "subsample_cap": 400,
    "time_budget_min": 90
  },
